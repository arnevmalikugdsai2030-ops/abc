# ==============================================================================
# MIRRORLAB Environment Configuration & Secrets Template
# ==============================================================================
# Copy this file to .env and insert your real credentials:
#   copy .env.example .env (Windows PowerShell)
#   cp .env.example .env   (Linux / macOS)
#
# IMPORTANT:
# - Secrets are loaded automatically from .env or system environment variables.
# - DO NOT commit your real .env file into git! It is git-ignored by default.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vision Model Provider Credentials
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for live Gemini evaluation)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional, for Claude evaluation)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT API Key (Optional, for GPT-4o evaluation)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Vision Adapter Execution Settings
# ------------------------------------------------------------------------------
# Sampling temperature (fixed at 0.0 for deterministic benchmark grading)
BENCHMARK_TEMPERATURE=0.0

# Maximum output completion tokens
BENCHMARK_MAX_TOKENS=2048

# Maximum retry attempts on transient network or rate-limit faults
BENCHMARK_MAX_RETRIES=3

# HTTP/API request timeout in seconds
BENCHMARK_TIMEOUT_SECONDS=30.0

# Initial backoff delay for exponential backoff retries (in seconds)
BENCHMARK_INITIAL_BACKOFF_SECONDS=1.0

# Exponential backoff multiplier
BENCHMARK_BACKOFF_MULTIPLIER=2.0
