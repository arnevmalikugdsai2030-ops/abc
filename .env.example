# ==============================================================================
# MIRRORLAB Environment Configuration Example
# ==============================================================================
# Copy this file to .env and insert your real credentials:
#   copy .env.example .env
#
# DO NOT commit your real .env file into git!
# ==============================================================================

# Google Gemini API Key (for Vision-Language Model Evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (Optional, for Claude evaluation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (Optional, for GPT-4o evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Evaluation Settings
BENCHMARK_TEMPERATURE=0.0
BENCHMARK_MAX_RETRIES=3
BENCHMARK_TIMEOUT_SECONDS=30
